<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>familiar</id>
    <!-- Bump alongside CMakeLists.txt's FAMILIAR_VERSION and the URL
         in tools/chocolateyInstall.ps1 below - nothing ties these
         together automatically. -->
    <version>0.0.16</version>
    <packageSourceUrl>https://github.com/try-hard-factory/familiar/tree/main/packaging/choco</packageSourceUrl>
    <owners>try-hard-factory</owners>
    <title>Familiar</title>
    <authors>try-hard-factory</authors>
    <projectUrl>https://github.com/try-hard-factory/familiar</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/try-hard-factory/familiar/main/data/img/app/familiar_256.png</iconUrl>
    <licenseUrl>https://github.com/try-hard-factory/familiar/blob/main/LICENSE</licenseUrl>
    <projectSourceUrl>https://github.com/try-hard-factory/familiar</projectSourceUrl>
    <bugTrackerUrl>https://github.com/try-hard-factory/familiar/issues</bugTrackerUrl>
    <tags>familiar reference-board reference-images 2d 3d art artists</tags>
    <summary>Reference board for 2D/3D artists</summary>
    <description>Familiar is a canvas for collecting, arranging, and annotating reference images - built for 2D/3D artists who need a fast, always-on-top board of source material next to their main work surface.</description>
    <releaseNotes>https://github.com/try-hard-factory/familiar/releases</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
